---
import T from "./T.astro";

const steps = [
  {
    es: {
      title: "Conecta tu número de WhatsApp",
      body: "Enlazas el número del negocio con WhatsApp Business. Es el mismo número que tus clientes ya tienen guardado.",
      note: "Una vez, al principio.",
    },
    en: {
      title: "Connect your WhatsApp number",
      body: "Link your business number through WhatsApp Business. It's the same number your clients already have saved.",
      note: "Once, at the start.",
    },
  },
  {
    es: {
      title: "Carga servicios, equipo y horario",
      body: "Precio y duración de cada servicio, quién trabaja y cuándo. Con eso el bot ya sabe qué puede ofrecer.",
      note: "Unos 10 minutos.",
    },
    en: {
      title: "Add services, staff and hours",
      body: "Price and duration per service, who works and when. That's all the bot needs to know what it can offer.",
      note: "About 10 minutes.",
    },
  },
  {
    es: {
      title: "Tus clientes escriben. Tú cortas.",
      body: "El bot atiende, propone horas libres y confirma. Tú miras la agenda del día y trabajas.",
      note: "Todos los días.",
    },
    en: {
      title: "Clients message. You work.",
      body: "The bot replies, offers open times and confirms. You look at today's schedule and get to it.",
      note: "Every day.",
    },
  },
];
---

<section id="como-funciona" class="border-t border-slate-900 px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <p data-reveal class="text-eyebrow mb-5 text-[11px] font-semibold uppercase text-emerald-400">
        <T es="Cómo funciona" en="How it works" />
      </p>
      <h2
        data-reveal
        style="--reveal-delay: 60ms"
        class="text-heading text-3xl font-semibold text-white sm:text-4xl"
      >
        <T es="Tres pasos, y ya está andando" en="Three steps and it's running" />
      </h2>
    </div>

    <ol class="mt-14 grid gap-4 md:grid-cols-3">
      {
        steps.map((s, i) => (
          <li
            data-reveal
            style={`--reveal-delay: ${i * 80}ms`}
            class="relative rounded-2xl border border-slate-800 bg-slate-900 p-7"
          >
            <span class="text-display block text-[2.75rem] font-semibold text-slate-800 tabular-nums">
              {String(i + 1).padStart(2, "0")}
            </span>

            <h3 class="text-heading mt-4 text-[17px] font-semibold text-white">
              <T es={s.es.title} en={s.en.title} />
            </h3>
            <p class="mt-2.5 text-[15px] leading-relaxed text-slate-400">
              <T es={s.es.body} en={s.en.body} />
            </p>

            <p class="mt-5 inline-flex items-center gap-2 rounded-lg bg-slate-950 px-2.5 py-1.5 text-xs font-medium text-emerald-400 ring-1 ring-slate-800">
              <svg
                class="h-3.5 w-3.5"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="8" cy="8" r="6" />
                <path d="M8 5v3l2 1.5" />
              </svg>
              <T es={s.es.note} en={s.en.note} />
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
