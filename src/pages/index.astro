---
import "../styles/global.css";
import T from "../components/T.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Pricing from "../components/Pricing.astro";
import Footer from "../components/Footer.astro";

const APP_URL = "https://barbershop-turnos.vercel.app/login";
const SITE_URL = "https://agendaos.com";

const nav = [
  { href: "#funciones", es: "Funciones", en: "Features" },
  { href: "#como-funciona", es: "Cómo funciona", en: "How it works" },
  { href: "#precios", es: "Precios", en: "Pricing" },
];
---

<!doctype html>
<html lang="es" data-lang="es" class="scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>AgendaOS — Reservas por WhatsApp para tu negocio</title>
    <meta
      name="description"
      content="AgendaOS contesta el WhatsApp de tu negocio, ofrece tus horarios libres y confirma la cita. Para barberías, salones y negocios de servicio en Puerto Rico."
    />
    <link rel="canonical" href={SITE_URL} />
    <meta name="theme-color" content="#020617" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="AgendaOS — Reservas por WhatsApp para tu negocio" />
    <meta
      property="og:description"
      content="Tus clientes reservan por WhatsApp. Tú solo abres el local."
    />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:locale" content="es_PR" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    <!-- Resolve language before first paint so nothing flashes in the wrong one. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("agendaos-lang");
          var lang =
            saved === "es" || saved === "en"
              ? saved
              : (navigator.language || "es").toLowerCase().startsWith("en")
                ? "en"
                : "es";
          document.documentElement.setAttribute("data-lang", lang);
          document.documentElement.setAttribute("lang", lang);
        } catch (e) {
          /* keep the server-rendered Spanish default */
        }
      })();
    </script>

    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>

  <body id="top" class="bg-slate-950 font-sans antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-emerald-500 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-slate-950"
    >
      <T es="Saltar al contenido" en="Skip to content" />
    </a>

    <!-- Header: translucent layer, content scrolls underneath -->
    <header
      id="site-header"
      class="site-header fixed inset-x-0 top-0 z-40 border-b"
    >
      <div class="mx-auto flex max-w-6xl items-center gap-6 px-6 py-4">
        <a href="#top" class="flex shrink-0 items-center gap-2.5">
          <span
            class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-500 text-slate-950"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M2.5 5.5h11M5.5 2v2M10.5 2v2"></path>
              <rect x="2.5" y="3.5" width="11" height="10" rx="1.5"></rect>
              <path d="m6 9.5 1.5 1.5 3-3"></path>
            </svg>
          </span>
          <span class="text-[15px] font-semibold tracking-tight text-white">AgendaOS</span>
        </a>

        <nav aria-label="Principal" class="ml-4 hidden items-center gap-7 md:flex">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="text-sm text-slate-400 transition-colors duration-150 hover:text-white"
              >
                <T es={item.es} en={item.en} />
              </a>
            ))
          }
        </nav>

        <div class="ml-auto flex items-center gap-3">
          <!-- Language toggle -->
          <div
            class="flex items-center rounded-lg border border-slate-800 bg-slate-900 p-0.5"
            role="group"
            aria-label="Idioma / Language"
          >
            <button
              type="button"
              class="lang-btn"
              data-lang-btn="es"
              lang="es"
              aria-label="Cambiar a español">ES</button
            >
            <button
              type="button"
              class="lang-btn"
              data-lang-btn="en"
              lang="en"
              aria-label="Switch to English">EN</button
            >
          </div>

          <a
            href={APP_URL}
            class="pressable hidden rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-emerald-400 sm:inline-flex"
          >
            <T es="Entrar" en="Sign in" />
          </a>
        </div>
      </div>
    </header>

    <main id="contenido">
      <Hero />
      <Features />
      <HowItWorks />
      <Pricing />
    </main>

    <Footer />

    <script is:inline>
      // --- Language toggle -------------------------------------------------
      document.querySelectorAll("[data-lang-btn]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var lang = btn.getAttribute("data-lang-btn");
          document.documentElement.setAttribute("data-lang", lang);
          document.documentElement.setAttribute("lang", lang);
          try {
            localStorage.setItem("agendaos-lang", lang);
          } catch (e) {
            /* private mode — the choice just won't persist */
          }
        });
      });

      // --- Scroll reveal ---------------------------------------------------
      var revealables = document.querySelectorAll("[data-reveal]");

      if (!("IntersectionObserver" in window)) {
        revealables.forEach(function (el) {
          el.classList.add("is-visible");
        });
      } else {
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.1 },
        );

        var onscreen = [];

        revealables.forEach(function (el) {
          if (el.getBoundingClientRect().top < window.innerHeight) {
            onscreen.push(el);
          } else {
            observer.observe(el);
          }
        });

        // Anything already on screen still has to *animate* in. Adding the
        // class in the same frame the element is painted gives the browser no
        // start value to transition from, so the hero would just appear. Two
        // frames guarantees the opacity:0 state has been rendered first.
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            onscreen.forEach(function (el) {
              el.classList.add("is-visible");
            });
          });
        });
      }

      // --- Header: material on scroll, retracts when scrolling down --------
      var header = document.getElementById("site-header");
      var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      var scrolled = false;
      var hidden = false;
      var lastY = window.scrollY;
      var ticking = false;

      function syncHeader() {
        ticking = false;
        var y = window.scrollY;

        var nextScrolled = y > 12;
        if (nextScrolled !== scrolled) {
          scrolled = nextScrolled;
          header.classList.toggle("is-scrolled", scrolled);
        }

        // Ignore jitter and the rubber-band overscroll at either end.
        var delta = y - lastY;
        if (Math.abs(delta) > 6 && y > 0) {
          // Only hide once the header is clear of the top of the page, and
          // never while an in-page anchor has focus behind it.
          var nextHidden = !reduceMotion.matches && delta > 0 && y > 120;
          if (nextHidden !== hidden) {
            hidden = nextHidden;
            header.classList.toggle("is-hidden", hidden);
          }
          lastY = y;
        }
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(syncHeader);
      }

      syncHeader();
      window.addEventListener("scroll", onScroll, { passive: true });

      // A keyboard user tabbing into the nav must not be looking at a header
      // that scrolled itself off screen.
      header.addEventListener("focusin", function () {
        if (!hidden) return;
        hidden = false;
        header.classList.remove("is-hidden");
      });
    </script>

    <style>
      .lang-btn {
        border-radius: 0.375rem;
        padding: 0.25rem 0.5rem;
        font-size: 12px;
        font-weight: 600;
        color: var(--color-slate-500);
        transition:
          color 150ms ease,
          background-color 150ms ease;
      }

      .lang-btn:hover {
        color: var(--color-slate-300);
      }

      html[data-lang="es"] .lang-btn[data-lang-btn="es"],
      html[data-lang="en"] .lang-btn[data-lang-btn="en"] {
        background-color: var(--color-slate-800);
        color: #fff;
      }
    </style>
  </body>
</html>
